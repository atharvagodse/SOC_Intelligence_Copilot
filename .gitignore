# ==============================================================================
# Enterprise SOC Intelligence Copilot — .gitignore
# ==============================================================================

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
eggs/
parts/
var/
sdist/
develop-eggs/
.installed.cfg
lib/
lib64/

# ── Virtual Environments ──────────────────────────────────────────────────────
venv/
.venv/
env/
ENV/

# ── Environment & Secrets ─────────────────────────────────────────────────────
.env
*.pem
*.key
secrets.json

# ── IDEs ──────────────────────────────────────────────────────────────────────
.vscode/settings.json
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# ── Project-specific ──────────────────────────────────────────────────────────
# ChromaDB persisted vector store (can be large)
vector_db/

# Raw/processed documents (may contain sensitive security data)
data/raw/
data/processed/

# Pytest cache
.pytest_cache/
htmlcov/
.coverage

# Streamlit
.streamlit/

# Logs
logs/
*.log

# Model caches (can be very large)
.cache/
models/

# Jupyter
.ipynb_checkpoints/
*.ipynb
