# ==============================================================================
# Enterprise SOC Intelligence Copilot — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ==============================================================================

# ── Ollama LLM Configuration ──────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b

# ── Embedding Model ───────────────────────────────────────────────────────────
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ── ChromaDB ─────────────────────────────────────────────────────────────────
CHROMA_PERSIST_DIR=./vector_db
CHROMA_COLLECTION_NAME=soc_knowledge_base

# ── Document Ingestion ────────────────────────────────────────────────────────
RAW_DOCS_DIR=./data/raw
PROCESSED_DOCS_DIR=./data/processed
MAX_FILE_SIZE_MB=50
ALLOWED_EXTENSIONS=pdf,txt,docx

# ── Chunking Parameters ───────────────────────────────────────────────────────
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# ── Retrieval Parameters ──────────────────────────────────────────────────────
TOP_K_RESULTS=5
SIMILARITY_THRESHOLD=0.3

# ── Application ───────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
APP_NAME=SOC Intelligence Copilot
APP_VERSION=0.1.0
